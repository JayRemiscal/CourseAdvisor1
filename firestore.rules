rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Security & ABAC Helper Functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Shared Course Catalog (Public read for authenticated students; Admin-only write)
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidId(courseId);
    }

    // Role-Based Access Control Admin Directory (Self-assignment strictly forbidden)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Student Private User Documents and Data Isolation
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // Student Academic Progress (Grades, Completed Courses)
      match /academicProgress/{recordId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(recordId);
        allow delete: if isOwner(userId);
      }

      // Student Academic Plans
      match /academicPlans/{planId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(planId);
        allow delete: if isOwner(userId);

        // Planned Semesters within a Plan
        match /semesters/{semesterId} {
          allow read: if isOwner(userId);
          allow create, update: if isOwner(userId) && isValidId(semesterId);
          allow delete: if isOwner(userId);
        }
      }

      // Student Self-Assessment Confidence Ratings (Mamdani FIS input)
      match /confidenceRatings/{courseCode} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(courseCode);
        allow delete: if isOwner(userId);
      }

      // Student Workload Assessment Results
      match /workloadAssessments/{assessmentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(assessmentId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
